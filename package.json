{
  "name": "stubhub-marketplace",
  "private": true,
  "workspaces": [
    "client",
    "common",
    "auth",
    "tickets",
    "event-bus",
    "orders"
  ],
  "scripts": {
    "dev": "skaffold dev",
    "delete": "skaffold delete",
    "cloud:preview": "npm --prefix infra/cloud run preview",
    "cloud:up": "npm --prefix infra/cloud run up",
    "cloud:destroy": "npm --prefix infra/cloud run destroy",
    "dev:client": "npm run dev --workspace @stubhub/client",
    "dev:identity": "npm run dev --workspace @stubhub/identity",
    "dev:tickets": "npm run dev --workspace @stubhub/tickets",
    "dev:orders": "npm run dev --workspace @stubhub/orders",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:commit": "npm run check:commit --workspace @stubhub/identity",
    "check:push": "npm run check:push --workspace @stubhub/identity"
  },
  "engines": {
    "node": ">=24"
  }
}
