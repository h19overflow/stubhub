{
  "name": "@stubhub/tickets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --watch migrations --watch ../common/src --ext ts,sql --exec \"npm run build && node --env-file-if-exists=.env dist/index.js\"",
    "build:common": "npm --prefix ../common run build",
    "build": "npm run build:common && tsc -p tsconfig.json",
    "migrate": "npm run build && node --env-file-if-exists=.env dist/database.js",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test:build": "npm run build:common && node -e \"require('node:fs').rmSync('dist-test', { recursive: true, force: true })\" && tsc -p tsconfig.test.json && node -e \"require('node:fs').cpSync('migrations', 'dist-test/migrations', { recursive: true })\"",
    "test": "npm run test:build && node --env-file=tests/test.env --test --test-concurrency=1 \"dist-test/tests/**/*.test.js\"",
    "test:integration": "npm run test:build && node --env-file=tests/test.env --test --test-concurrency=1 \"dist-test/tests/integration/**/*.test.js\"",
    "typecheck": "npm run build:common && tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@stubhub/common": "0.1.0",
    "express": "^5.2.1",
    "multer": "^2.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^26.2.0",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  }
}
